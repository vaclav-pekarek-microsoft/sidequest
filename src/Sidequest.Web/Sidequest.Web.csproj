<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Sidequest_Web-c0a01f43-25b9-411b-8761-85c1fe8517de</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <SidequestStyleRoot>$(MSBuildProjectDirectory)\..\..</SidequestStyleRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.4" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <ProjectReference Include="..\Sidequest.Application\Sidequest.Application.csproj" />
    <ProjectReference Include="..\Sidequest.Infrastructure\Sidequest.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sidequest.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <SidequestStyleSource Include="Components\**\*.scss;wwwroot\**\*.scss" Exclude="**\_*.scss" />
    <SidequestGeneratedStyle Include="@(SidequestStyleSource->'%(RelativeDir)%(Filename).css')" />
    <Content Include="@(SidequestGeneratedStyle)" Exclude="@(Content)" />
    <None Remove="@(SidequestGeneratedStyle)" />
    <Content Remove="wwwroot\**\*.scss" />
    <Content Include="appsettings.Development.json" Condition="!Exists('appsettings.Development.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json;appsettings.Development.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="CreateLocalDevelopmentSettings" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\appsettings.Development.json')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\appsettings.Development.example.json" DestinationFiles="$(MSBuildProjectDirectory)\appsettings.Development.json" />
  </Target>

  <Target Name="RestoreSidequestStyles"
          Inputs="$(SidequestStyleRoot)\package.json;$(SidequestStyleRoot)\package-lock.json"
          Outputs="$(SidequestStyleRoot)\node_modules\.sidequest-styles-restored;$(SidequestStyleRoot)\node_modules\sass\sass.js">
    <Exec Command="npm ci --ignore-scripts --no-audit --no-fund" WorkingDirectory="$(SidequestStyleRoot)" />
    <Touch Files="$(SidequestStyleRoot)\node_modules\.sidequest-styles-restored" AlwaysCreate="true" />
  </Target>

  <Target Name="CompileSidequestStyles" BeforeTargets="PrepareForBuild;ResolveScopedCssInputs"
          DependsOnTargets="RestoreSidequestStyles" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run styles" WorkingDirectory="$(SidequestStyleRoot)" />
    <ItemGroup>
      <FileWrites Include="@(SidequestGeneratedStyle)" />
    </ItemGroup>
  </Target>

</Project>
