@using Sidequest.Web.Components.Media
<article class="event-card @(DetailLayout ? "event-card-detail" : null)">
    <div class="event-card-media">
        <PlaceholderCover Name="@Item.Name" Width="900" Height="540" />
    </div>
    <div class="event-card-content">
        <h2><a href="@($"/events/{Item.Id}")">@Item.Name</a></h2>
        <p>@Item.Status · @Item.StartDate.ToString("d") – @Item.EndDate.ToString("d") · @Item.TimeZoneId</p>
        <p>@Item.DiscoverySummary</p>
        @if (Description is not null)
        {
            <p class="description">@Description</p>
        }
        <p class="event-contacts">Contacts:
            @foreach (var owner in Item.Owners)
            {
                <span @key="owner.Id">@owner.Email (@owner.DisplayName) </span>
            }
        </p>
        @if (ShowParticipationActions)
        {
            <EventParticipationActions Item="Item" Busy="Busy"
                                       ShowNotificationPreferences="ShowNotificationPreferences"
                                       ShowOwnershipGuidance="ShowOwnershipGuidance"
                                       JoinRequested="JoinRequested" LeaveRequested="LeaveRequested">
                @AdditionalActions
            </EventParticipationActions>
        }
    </div>
</article>

@code {
    /// <summary>Authorized summary; descriptions, rosters, and private Quest data never belong in discovery cards.</summary>
    [Parameter, EditorRequired] public EventSummary Item { get; set; } = null!;

    /// <summary>Full authorized Event description rendered only on the detail page.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Whether the card uses the wide detail composition with media beside its content.</summary>
    [Parameter] public bool DetailLayout { get; set; }

    /// <summary>Whether this card renders Join, Leave, ownership guidance, and optional additional actions.</summary>
    [Parameter] public bool ShowParticipationActions { get; set; }

    /// <summary>Whether joined members receive the Event-scoped notification preferences link.</summary>
    [Parameter] public bool ShowNotificationPreferences { get; set; }

    /// <summary>Whether ownership-related leave guidance is rendered for this detail context.</summary>
    [Parameter] public bool ShowOwnershipGuidance { get; set; }

    /// <summary>Whether the owning Event list is running an operation.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Additional authorized actions rendered with participation controls.</summary>
    [Parameter] public RenderFragment? AdditionalActions { get; set; }

    /// <summary>Requests repeat-safe direct joining from the owning list.</summary>
    [Parameter] public EventCallback<Guid> JoinRequested { get; set; }

    /// <summary>Requests leave confirmation from the owning page.</summary>
    [Parameter] public EventCallback<Guid> LeaveRequested { get; set; }
}
