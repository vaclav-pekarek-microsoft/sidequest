@inherits EventViewBase
@inject NavigationManager Navigation
@inject Sidequest.Application.Events.Implementation.IEventManagementQueries Management

<section class="section-box" aria-label="Owner lifecycle actions">
    <h2 class="section-heading">Event actions</h2>
    <EventFeedback Busy="Busy" Error="@Error" />
    @if (Item.Status == EventStatus.Draft)
    {
        <p>This legacy Draft predates one-step Event creation. Activating it lists the Event and enables membership.</p>
        <FluentButton Disabled="@Busy" OnClick="@(() => TransitionAsync(EventStatus.Active))">Activate legacy Event</FluentButton>
    }
    @if (Item.Status is EventStatus.Draft or EventStatus.Active)
    {
        <FluentButton Disabled="@Busy" OnClick="OpenCancellationAsync">Cancel Event…</FluentButton>
    }
    @if (Item.Status is EventStatus.Completed or EventStatus.Cancelled)
    {
        <p>Archive retains authorized history and access revocation. All Quests must be completed, cancelled, or archived.</p>
        <FluentButton Disabled="@Busy" OnClick="@(() => TransitionAsync(EventStatus.Archived))">Archive Event</FluentButton>
    }
    @if (Item.Status == EventStatus.Draft)
    {
        <FluentButton Disabled="@Busy" OnClick="@(() => deleteDialogOpen = true)">Delete legacy Draft…</FluentButton>
    }
</section>

<ConfirmActionDialog Open="cancellationDialogOpen"
                     Title="Cancel Event"
                     ConfirmLabel="Cancel Event and affected Quests"
                     Busy="Busy"
                     ConfirmDisabled="@(affectedQuests is null || reason.Trim().Length < 10)"
                     Confirmed="@(() => TransitionAsync(EventStatus.Cancelled))"
                     Dismissed="CloseCancellation">
    @if (affectedQuests is { } count)
    {
        <p role="status">Cancellation currently affects @count Draft, Active, or Suspended child Quests. Counts may change while you review.</p>
    }
    <p>This cancels affected child Quests, closes pending membership work, and withdraws applicable calendars. It cannot be undone.</p>
    <FluentTextArea Name="event-cancellation-reason" Label="Cancellation reason (10–2,000 characters)"
                    @bind-Value="reason" Maxlength="2000" Disabled="@Busy" />
</ConfirmActionDialog>

<ConfirmActionDialog Open="deleteDialogOpen"
                     Title="Delete legacy Draft Event"
                     ConfirmLabel="Delete Draft permanently"
                     Busy="Busy"
                     Confirmed="DeleteAsync"
                     Dismissed="@(() => deleteDialogOpen = false)">
    <p>Permanently delete this unpublished legacy Draft? Deletion is allowed only when it has no requests, invitations, or Quests.</p>
</ConfirmActionDialog>

@code {
    private string reason = "";
    private bool cancellationDialogOpen;
    private bool deleteDialogOpen;
    private int? affectedQuests;
    /// <summary>Owner-authorized lifecycle and rowversion snapshot; never mutated by this component.</summary>
    [Parameter, EditorRequired] public EventSummary Item { get; set; } = null!;
    /// <summary>Requests parent reload after a successful lifecycle transition or an access denial.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private async Task OpenCancellationAsync()
    {
        await RunAsync(async token =>
        {
            affectedQuests = null;
            affectedQuests = await Management.GetCancellationImpactAsync(Item.Id, token);
            cancellationDialogOpen = true;
        });
        if (Error is not null)
            await Changed.InvokeAsync();
    }

    private void CloseCancellation()
    {
        cancellationDialogOpen = false;
        affectedQuests = null;
        reason = "";
    }

    private async Task TransitionAsync(EventStatus target)
    {
        await RunMutationAsync(async token =>
        {
            await Events.ChangeStatusAsync(Item.Id, Item.Version, target, reason, token);
            affectedQuests = null;
            reason = "";
            cancellationDialogOpen = false;
            deleteDialogOpen = false;
        });
        await Changed.InvokeAsync();
    }
    private async Task DeleteAsync()
    {
        await RunMutationAsync(async token =>
        {
            await Events.DeleteDraftAsync(Item.Id, Item.Version, token);
            Navigation.NavigateTo("/events");
        });
        if (Error is not null)
            await Changed.InvokeAsync();
    }
    /// <inheritdoc />
    protected override void ClearProtectedState()
    {
        affectedQuests = null;
        cancellationDialogOpen = false;
        deleteDialogOpen = false;
    }
}
