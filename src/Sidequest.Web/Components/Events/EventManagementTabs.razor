@if (CanManage)
{
    <nav class="management-tabs" aria-label="Event management tabs">
        @foreach (var tab in Tabs)
        {
            <button @key="tab.Id" type="button" role="tab" aria-selected="@(Selected == tab.Id)"
                    class="@(Selected == tab.Id ? "selected" : null)" disabled="@Disabled"
                    @onclick="() => SelectedChanged.InvokeAsync(tab.Id)">@tab.Label</button>
        }
    </nav>
}

@code {
    private static readonly IReadOnlyList<(string Id, string Label)> Tabs =
        [("detail", "Detail"), ("quests", "Quests"), ("members", "Members"), ("invitations", "Invitations"), ("settings", "Settings")];

    /// <summary>Identifier of the tab currently owned by the Event detail page.</summary>
    [Parameter, EditorRequired] public string Selected { get; set; } = "detail";
    /// <summary>Whether the actor is the creator, an assigned owner, or an administrator permitted to see management tabs.</summary>
    [Parameter] public bool CanManage { get; set; }
    /// <summary>Whether tab changes are temporarily unavailable.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Notifies the Event detail page when the user selects a tab.</summary>
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
}
