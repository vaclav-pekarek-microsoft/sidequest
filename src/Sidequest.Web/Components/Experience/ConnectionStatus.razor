@using Sidequest.Web.Experience
<aside @ref="root" aria-label="Connection, installation and device basics">
    <p data-connection role="status">Connecting… Online actions require a working server connection.</p>
    <p data-snapshot role="status">Device basics have not been refreshed in this view.</p>
    <p><a href="/experience/offline.html" data-enhance-nav="false">Read saved joined basics</a> · <a href="/install">Install and device privacy</a></p>
    <button type="button" data-refresh disabled="@(!RendererInfo.IsInteractive)">Refresh saved joined basics</button>
    <button type="button" data-install hidden>Install Sidequest</button>
    <p data-install-status role="status"></p>
    <small>Joined private Quest basics may be saved on this device for up to 24 hours. Anyone sharing this browser profile may read them. Storage and installation are not guaranteed.</small>
</aside>
