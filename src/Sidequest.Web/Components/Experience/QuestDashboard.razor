@rendermode InteractiveServer
<header class="dashboard-intro">
    <div>
        <p class="eyebrow">Make room for a shared experience</p>
        <h1>My Quests</h1>
        <p>Everything happening in your Events. Your joined Quests come first; find something new to share.</p>
    </div>
    <a class="button-link" href="/quests/create" data-online-actions>Create a Quest</a>
</header>
<nav class="dashboard-shortcuts" aria-label="Quest shortcuts" data-online-actions>
    <a href="/events">Browse Events</a>
    <a href="/quests?view=History">Quest history</a>
    <a href="/quests?view=Invited">Private invitations</a>
</nav>
<DashboardFilters Events="events" EventPage="eventPage" EventTotal="eventTotal" EventPageChanged="EventPageAsync"
                  Disabled="@(loading || !RendererInfo.IsInteractive || !Coordinator.CanUseOnlineActions)" Changed="FilterAsync" />
<section class="dashboard-results" data-protected-experience data-online-actions aria-label="Authorized Quest results" aria-busy="@loading">
    <h2>@Heading</h2>
    @if (loading)
    {
        <p class="state-panel" role="status">Loading authorized Quests…</p>
    }
    else if (error is not null)
    {
        <p class="state-panel error-message" role="alert">@error</p>
        <button type="button" disabled="@(!RendererInfo.IsInteractive || !Coordinator.CanUseOnlineActions)" @onclick="LoadAsync">Reload authorized Quests</button>
    }
    else if (result is null || result.Quests.Items.Count == 0)
    {
        <div class="state-panel">
            <h3>A little space for something great</h3>
            <p>No Quests in this view. Try another Event or date range. Invited Quests grant immediate access; no acceptance is required.</p>
            <a href="/events">Explore your Events</a>
        </div>
    }
    else
    {
        <p class="result-caption">@result.Quests.TotalCount matching Quests.
            @(filter.Kind == Sidequest.Application.Quests.QuestListKind.Board
                ? "Joined first, then start date and time in each Event's time zone. Past and cancelled Quests keep their status."
                : "Ordered by start time, then identifier.")</p>
        <div class="quest-board">
            @foreach (var item in result.Quests.Items)
            {
                <DashboardQuestCard @key="item.Id" Item="item" InvitedCount="@(result.InvitedCounts.TryGetValue(item.Id, out var count) ? count : null)" />
            }
        </div>
    }
    <div class="dashboard-pagination">
        <button type="button" disabled="@(loading || !RendererInfo.IsInteractive || !Coordinator.CanUseOnlineActions || page == 1)" @onclick="PreviousAsync">Previous Quests</button>
        <span>Page @(page)</span>
        <button type="button" disabled="@(loading || !RendererInfo.IsInteractive || !Coordinator.CanUseOnlineActions || result is null || (long)page * filter.PageSize >= result.Quests.TotalCount)" @onclick="NextAsync">Next Quests</button>
    </div>
</section>
