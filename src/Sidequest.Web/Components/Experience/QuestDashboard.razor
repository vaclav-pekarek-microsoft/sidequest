@namespace Sidequest.Web.Components.Experience

<section class="quest-home">
    <header class="page-header">
        <p class="eyebrow">Your Sidequest</p>
        <h1>Quests at a glance</h1>
        <p class="text-muted">See what is happening now, what is next, and which invitations await you.</p>
    </header>

    @if (isLoading)
    {
        <p>Loading Quest overview...</p>
    }
    else if (data is null)
    {
        <div class="alert error" role="alert">
            <p>@error</p>
            <FluentButton Appearance="Appearance.Accent" OnClick="LoadAsync">Try again</FluentButton>
        </div>
    }
    else
    {
        @if (error is not null)
        {
            <p class="alert error" role="alert">@error</p>
        }

        <QuestHomeStatistics UpcomingJoinedCount="data.UpcomingJoinedCount"
                             UpcomingTotalCount="data.UpcomingTotalCount"
                             ActiveCount="data.ActiveCount"
                             PastCount="data.PastCount" />

        <QuestHomeQuestList Title="Happening now"
                            Items="data.ActiveQuests"
                            EmptyMessage="No Quests are active right now." />

        <div class="quest-home-upcoming">
            <QuestHomeQuestList Title="Upcoming joined"
                                Items="data.UpcomingJoined"
                                EmptyMessage="You have no upcoming joined Quests." />
            <QuestHomeQuestList Title="Upcoming following"
                                Items="data.UpcomingFollowing"
                                EmptyMessage="You have no upcoming followed Quests." />
        </div>

        <QuestInvitationTable Items="data.Invitations"
                              Busy="@(isJoining || !RendererInfo.IsInteractive || !Experience.CanUseOnlineActions)"
                              JoinRequested="JoinInvitationAsync" />
    }
</section>
