@using Sidequest.Application.Quests
@using Sidequest.Web.Components.Media
<article class="dashboard-quest-card">
    <QuestCover AssetId="Item.CoverAssetId" QuestTitle="@Item.Title" />
    <h3><a href="@($"/quests/{Item.Id}")">@Item.Title</a></h3>
    <p>@Item.EventName · @Item.Status · @Item.Visibility</p>
    <QuestTimeDisplay ZoneId="@Item.TimeZoneId" StartUtc="@Item.StartUtc" EndUtc="@Item.EndUtc" />
    <p>@Item.Location</p>
    <p>You: @Item.Participation @(Item.IsOwner ? "· Organizing" : "")</p>
    @if (Item.AttendeeCount is not null)
    {
        <p>@Item.AttendeeCount joined · @Item.FollowerCount following</p>
    }
    @if (Item.IsOwner && InvitedCount is not null)
    {
        <p>@InvitedCount invited (active eligible Event members)</p>
    }
    @if (Item.SuggestedCapacity is not null)
    {
        <p>Suggested capacity: @Item.SuggestedCapacity. @(Item.AttendeeCount > Item.SuggestedCapacity ? "Above suggested capacity; joining remains allowed." : "Not a joining limit.")</p>
    }
</article>

@code {
    /// <summary>Authorized summary from the current paged list; no per-card detail query is performed.</summary>
    [Parameter, EditorRequired] public QuestSummary Item { get; set; } = default!;
    /// <summary>Current eligible invitation count for an owned private Quest; null withholds the statistic.</summary>
    [Parameter] public int? InvitedCount { get; set; }
}
