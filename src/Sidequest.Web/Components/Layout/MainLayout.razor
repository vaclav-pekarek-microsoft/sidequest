@inherits LayoutComponentBase
@inject FoundationAuthenticationSettings Authentication

<a class="skip-link" href="#main">Skip to main content</a>
@if (Authentication.IsDevelopment)
{
    <div class="development-banner" role="status">
        SYNTHETIC DEVELOPMENT — local test identities, not verified Entra workforce accounts.
    </div>
}
<header class="site-header">
    <a class="brand" href="/">Sidequest</a>
    <nav aria-label="Main navigation">
        <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink href="/foundation">Compatibility screen</NavLink>
                <form action="/auth/logout" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit">Sign out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="/signin" data-enhance-nav="false">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>
<main id="main" tabindex="-1">
    <ErrorBoundary>
        <ChildContent>@Body</ChildContent>
        <ErrorContent>
            <h1>Something went wrong</h1>
            <p>Reload this page to reconnect. If the problem continues, contact support.</p>
            <a href="/" data-enhance-nav="false">Reload home</a>
        </ErrorContent>
    </ErrorBoundary>
</main>
<footer>M1 foundation · Events and Quests are not implemented yet.</footer>
<div id="blazor-error-ui" role="alert">
    The connection or screen encountered an error.
    <a href="" class="reload">Reload</a>
</div>
