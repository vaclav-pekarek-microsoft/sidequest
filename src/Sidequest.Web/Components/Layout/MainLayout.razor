@inherits LayoutComponentBase
@inject FoundationAuthenticationSettings Authentication
@using Sidequest.Web.Components.Experience

<a class="skip-link" href="#main">Skip to main content</a>
@if (Authentication.IsDevelopment)
{
    <div class="development-banner" role="status">
        SYNTHETIC DEVELOPMENT — local test identities, not verified Entra workforce accounts.
    </div>
}
<header class="site-header">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">S</span>Sidequest</a>
    <nav aria-label="Main navigation">
        <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink href="/quests">Quests</NavLink>
                <NavLink href="/events">Events</NavLink>
                <NavLink href="/notifications">Notifications</NavLink>
                <NavLink href="/administration">Administration</NavLink>
                <form action="/auth/logout" method="post" data-enhance="false" data-authentication-change>
                    <AntiforgeryToken />
                    <input type="hidden" name="experienceClearFailed" value="true" />
                    <button class="button-quiet" type="submit">Sign out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <SignInLink />
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>
<noscript>
    <p>JavaScript is unavailable. Sign-out ends the server session but cannot clear saved device basics. Clear this site's data in browser settings before sharing the device.</p>
</noscript>
<p data-authentication-warning role="alert" hidden="@(!DeviceClearFailed)">
    Device basics could not be cleared. Sign-out is still available. Close other Sidequest tabs and clear this site's data in browser settings before sharing this device.
</p>
<div id="components-reconnect-modal" class="components-reconnect-hide" role="status" aria-live="polite">
    <p data-reconnect-message>Connection interrupted. Online actions are unavailable; unsaved input is kept.</p>
    <button type="button" data-reconnect-retry>Retry connection</button>
    <button type="button" data-reconnect-reload>Reload page (discards unsaved input)</button>
</div>
<main id="main" tabindex="-1" data-online-actions data-protected-experience data-requires-session="@(HttpContext?.User.Identity?.IsAuthenticated == true ? "true" : "false")">
    <ErrorBoundary>
        <ChildContent>@Body</ChildContent>
        <ErrorContent>
            <h1>Something went wrong</h1>
            <p>Reload this page to reconnect. If the problem continues, contact support.</p>
            <a href="/" data-enhance-nav="false">Reload home</a>
        </ErrorContent>
    </ErrorBoundary>
</main>
<footer>
    <div class="footer-links">
        <span>Sidequest · Make time for a Quest.</span>
        <a href="/install">Install and device privacy</a>
    </div>
    <ConnectionStatus @rendermode="InteractiveServer" />
</footer>
<div id="blazor-error-ui" role="alert">
    The connection or screen encountered an error.
    <a href="" class="reload">Reload</a>
</div>

@code {
    /// <summary>Gets the current static HTTP render context; it is never used from an interactive circuit.</summary>
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private bool DeviceClearFailed => HttpContext?.Request.Query["deviceClearFailed"].ToString() == "true";
}
