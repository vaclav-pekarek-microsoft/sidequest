@namespace Sidequest.Web.Components.Media
@using Microsoft.AspNetCore.Components.Forms

<section class="cover-editor section-box" aria-label="Quest cover">
    <h2 class="section-heading">Quest cover</h2>
    @if (!unavailable)
    {
        <QuestCover AssetId="AssetId" QuestTitle="@QuestTitle" />
    }
    <p id="@helpId">Optional JPEG, PNG or WebP; up to 2 MiB and 20 megapixels. Images are stored privately as PNG.</p>
    @if (QuestId == Guid.Empty)
    {
        <p>Save your draft before adding a cover.</p>
    }
    @if (RendererInfo.IsInteractive && QuestId != Guid.Empty)
    {
        <label>
            Upload cover
            <InputFile OnChange="UploadAsync" accept="image/jpeg,image/png,image/webp"
                       disabled="@Disabled" aria-describedby="@helpId" />
        </label>
    }
    else
    {
        <label>Upload cover <input type="file" disabled aria-describedby="@helpId" /></label>
        @if (!RendererInfo.IsInteractive)
        {
            <p>Connecting to enable cover changes…</p>
        }
    }
    <div class="page-actions">
        <button type="button" disabled="@(Disabled || AssetId is null)" @onclick="RemoveAsync">Remove cover</button>
    </div>
    @if (busy)
    {
        <p role="status">Processing cover… The previous cover remains until this succeeds.</p>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <p role="alert">@error</p>
    }
    @if (!string.IsNullOrEmpty(success))
    {
        <p role="status">@success</p>
    }
</section>
