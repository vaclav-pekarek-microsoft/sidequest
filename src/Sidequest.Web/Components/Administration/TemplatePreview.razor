@using Sidequest.Application.Administration
@if (Preview is not null)
{
    <section aria-labelledby="template-preview-title">
        <h2 id="template-preview-title">Synthetic preview — not sent</h2>
        <p>Template @Preview.Key, revision @Preview.Revision. Only synthetic branding and safe generic business wording are supplied.</p>
        <h3>Subject</h3>
        <p>@Preview.Subject</p>
        <h3>HTML body</h3>
        <div>@((MarkupString)Preview.HtmlBody)</div>
        <h3>Plain-text alternative</h3>
        <pre>@Preview.TextBody</pre>
    </section>
}

@code {
    /// <summary>Server-validated synthetic output using the closed inert HTML policy; null hides the preview.</summary>
    [Parameter] public RenderedBusinessEmail? Preview { get; set; }
}
