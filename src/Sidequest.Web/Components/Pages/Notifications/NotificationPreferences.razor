@page "/notifications/preferences"
@page "/notifications/preferences/{EventId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits Sidequest.Web.Components.Notifications.NotificationViewBase

<PageTitle>Notification preferences · Sidequest</PageTitle>
<h1>Notification preferences</h1>
<a href="/notifications">Back to notifications</a>
<p>Required invitations, access decisions, service messages and calendar updates cannot be disabled here.</p>
<p>Calendar clients may ask you to accept changes. Declining in Outlook does not change Sidequest attendance: leave in Sidequest.</p>
<div role="status" aria-live="polite">@Status</div>
@if (Error is not null)
{
    <p role="alert">@Error</p>
}
@if (!CanDisplayProtectedState || model is null)
{
    <p>@(Busy ? "Loading preferences…" : "Preferences are unavailable.")</p>
    <FluentButton OnClick="RetryAsync" Disabled="@RefreshDisabled">Retry</FluentButton>
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="notification-preferences">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset class="section-box" disabled="@ControlsDisabled">
            <legend class="section-heading">Optional email</legend>
            <FluentCheckbox Name="notification-new-quest-email" @bind-Value="model.NewQuestEmail" Disabled="@ControlsDisabled">Email me about new public Quests</FluentCheckbox>
            <FluentCheckbox Name="notification-activity-email" @bind-Value="model.ActivityEmail" Disabled="@ControlsDisabled">Email me optional joined/followed Quest activity</FluentCheckbox>
        </fieldset>
        <fieldset class="section-box" disabled="@ControlsDisabled">
            <legend class="section-heading">Reminders and time zone</legend>
            <FluentCheckbox Name="notification-reminders" @bind-Value="model.RemindersEnabled" Disabled="@ControlsDisabled">Enable attendee reminders (email and in-app)</FluentCheckbox>
            <label for="reminder-hours">Remind me this many hours before start (0.01–168, up to two decimal places)</label>
            <InputNumber id="reminder-hours" @bind-Value="model.ReminderHours" min="0.01" max="168" step="0.01" />
            <ValidationMessage For="@(() => model.ReminderHours)" />
            <FluentTextField Name="notification-time-zone" Label="Preferred IANA time zone (optional)" @bind-Value="model.TimeZoneId" Disabled="@ControlsDisabled" />
        </fieldset>
        <div class="page-actions">
            <FluentButton Type="ButtonType.Submit" Disabled="@ControlsDisabled">Save preferences</FluentButton>
        </div>
    </EditForm>
    @if (EventId is not null)
    {
        <section class="section-box" aria-labelledby="event-preference-heading">
            <h2 class="section-heading" id="event-preference-heading">This Event's new-Quest email</h2>
            <p>This explicit override replaces your default for this Event only. Current Event membership is required.</p>
            <FluentCheckbox Name="notification-event-email" @bind-Value="eventEnabled" Disabled="@ControlsDisabled">Enable new-Quest email for this Event</FluentCheckbox>
            <FluentButton OnClick="SaveEventAsync" Disabled="@ControlsDisabled">Save Event override</FluentButton>
        </section>
    }
}
