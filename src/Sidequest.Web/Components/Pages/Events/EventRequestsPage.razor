@page "/events/requests"
@page "/events/{Id:guid}/requests"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits EventViewBase

<PageTitle>Membership requests · Sidequest</PageTitle>
<h1>@(Id is null ? "My membership requests" : "Manage membership requests")</h1>
<nav class="page-actions" aria-label="Request actions">
    <a href="@(Id is { } eventId ? $"/events/{eventId}" : "/events")">@(Id is null ? "Back to Events" : "Back to Event")</a>
    <FluentButton Disabled="@Busy" OnClick="LoadAsync">Reload</FluentButton>
</nav>
<EventFeedback Busy="Busy" Error="@Error" />
@if (Id is not null)
{
    <section class="section-box" aria-label="Membership decision">
        <h2 class="section-heading">Decision reason</h2>
        <FluentTextArea Label="Decision reason (required for rejection, 10–2,000 characters)" @bind-Value="reason" Maxlength="2000" Disabled="@Busy" />
    </section>
}
@if (result is not null)
{
    @if (result.Items.Count == 0)
    {
        <p>No membership requests.</p>
    }
    @foreach (var request in result.Items)
    {
        <article @key="request.Id" class="section-box">
            <h2>@request.EventName</h2>
            <p>@request.User.Label</p>
            <p>@request.Status · @request.CreatedUtc.ToString("g") UTC</p>
            <p>@request.Reason</p>
            @if (request.Status == MembershipRequestStatus.Pending)
            {
                @if (Id is null)
                {
                    <FluentButton Disabled="@Busy" OnClick="@(() => ActAsync(request.Id, null))">Withdraw request</FluentButton>
                }
                else
                {
                    <FluentButton Disabled="@Busy" OnClick="@(() => ActAsync(request.Id, true))">Approve membership</FluentButton>
                    <FluentButton Disabled="@(Busy || reason.Trim().Length < 10)" OnClick="@(() => ActAsync(request.Id, false))">Reject with reason</FluentButton>
                }
            }
        </article>
    }
    <EventPager Page="page" TotalCount="result.TotalCount" Busy="Busy" Changed="PageAsync" />
}

@code {
    /// <summary>Managed Event identifier, or null for requests belonging only to the current user.</summary>
    [Parameter] public Guid? Id { get; set; }
    private PageResult<RequestSummary>? result;
    private string reason = "";
    private int page = 1;
    /// <inheritdoc />
    protected override Task OnParametersSetAsync()
    {
        page = 1;
        return LoadAsync();
    }
    private Task LoadAsync() => RunAsync(RefreshAsync);
    /// <inheritdoc />
    protected override Task RefreshAfterReconnectAsync() => LoadAsync();
    private async Task RefreshAsync(CancellationToken token)
    {
        result = null;
        var loaded = await Events.ListRequestsAsync(Id, new(page), token);
        token.ThrowIfCancellationRequested();
        result = loaded;
    }
    private Task ActAsync(Guid request, bool? approve) => RunMutationAsync(async token =>
    {
        if (approve is { } decision)
            await Events.DecideRequestAsync(request, decision, reason, token);
        else
            await Events.WithdrawRequestAsync(request, token);
        await RefreshAsync(token);
    });
    private Task PageAsync(int selected)
    {
        page = selected;
        return LoadAsync();
    }
    /// <inheritdoc />
    protected override void ClearProtectedState() => result = null;
}
