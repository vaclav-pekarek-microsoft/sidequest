@page "/events/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits EventViewBase
@inject NavigationManager Navigation

<PageTitle>Event · Sidequest</PageTitle>
<h1>Event</h1>
<nav class="page-actions" aria-label="Event navigation">
    <a href="/events">Back to Events</a>
    @if (Error is not null)
    {
        <FluentButton Disabled="@Busy" OnClick="LoadAsync">Reload and recheck access</FluentButton>
    }
</nav>
<EventFeedback Busy="Busy" Error="@Error" />
@if (detail is not null)
{
    @if (detail.Summary.CanManage)
    {
        <EventManagementTabs Selected="selectedTab" CanManage="detail.Summary.CanManage" Disabled="Busy"
                             SelectedChanged="SelectTabAsync" />
        @switch (selectedTab)
        {
            case "detail":
                <EventCard Item="detail.Summary" Description="@detail.Description" DetailLayout="true"
                           ShowParticipationActions="true" ShowNotificationPreferences="true"
                           JoinRequested="JoinAsync" LeaveRequested="OpenLeaveDialogAsync">
                    <AdditionalActions>
                        @if (detail.Summary.Status == EventStatus.Active)
                        {
                            <a href="@($"/events/{Id}/bulk")">One-time group add/invite</a>
                        }
                    </AdditionalActions>
                </EventCard>
                break;
            case "quests" when detail.Summary.CanManage:
                <EventQuestsPanel EventId="Id"
                                  CanCreate="@(detail.Summary.Status == EventStatus.Active)"
                                  CanModerate="detail.Summary.CanManage" />
                break;
            case "members" when detail.Summary.CanManage:
                <EventMembersPanel EventId="Id" Changed="LoadAsync" />
                break;
            case "invitations" when detail.Summary.CanManage:
                <EventInvitationsPanel EventId="Id" />
                break;
            case "settings" when detail.Summary.CanManage:
                <EventSettingsPanel Detail="detail" Changed="LoadAsync" />
                break;
            default:
                break;
        }
    }
    else
    {
        <EventCard Item="detail.Summary" Description="@detail.Description" DetailLayout="true"
                   ShowParticipationActions="true" ShowNotificationPreferences="true"
                   JoinRequested="JoinAsync" LeaveRequested="OpenLeaveDialogAsync" />
    }
}

<ConfirmActionDialog Open="leaveDialogOpen"
                     Title="Leave Event"
                     ConfirmLabel="Leave Event"
                     Busy="Busy"
                     Error="@Error"
                     Confirmed="LeaveAsync"
                     Dismissed="@(() => leaveDialogOpen = false)">
    <p>Leaving removes your Quest invitations, attendance, follows, and applicable calendar entries for this Event.</p>
</ConfirmActionDialog>

@code {
    /// <summary>Internal Event route identifier; every load reauthorizes it on the server.</summary>
    [Parameter] public Guid Id { get; set; }
    private EventDetail? detail;
    private string selectedTab = "detail";
    private bool leaveDialogOpen;
    /// <inheritdoc />
    protected override Task OnParametersSetAsync() => LoadAsync();
    /// <inheritdoc />
    protected override Task RefreshAfterReconnectAsync() => LoadAsync();
    private Task LoadAsync() => RunAsync(async token =>
    {
        detail = null;
        leaveDialogOpen = false;
        var loaded = await Events.GetAsync(Id, token);
        token.ThrowIfCancellationRequested();
        detail = loaded;
        if (!loaded.Summary.CanManage)
            selectedTab = "detail";
    });

    private Task JoinAsync(Guid _) => RunMutationAsync(async token =>
    {
        await Events.JoinAsync(Id, token);
        var loaded = await Events.GetAsync(Id, token);
        token.ThrowIfCancellationRequested();
        detail = loaded;
    });

    private Task SelectTabAsync(string tab)
    {
        if (detail?.Summary.CanManage != true)
            return Task.CompletedTask;
        selectedTab = tab;
        return Task.CompletedTask;
    }

    private Task OpenLeaveDialogAsync(Guid _)
    {
        leaveDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task LeaveAsync() => RunMutationAsync(async token =>
    {
        await Events.LeaveAsync(Id, token);
        detail = null;
        leaveDialogOpen = false;
        Navigation.NavigateTo("/events");
    });
    /// <inheritdoc />
    protected override void ClearProtectedState() => detail = null;
}
