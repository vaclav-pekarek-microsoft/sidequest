@page "/events/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits EventViewBase
@inject NavigationManager Navigation

<PageTitle>Event · Sidequest</PageTitle>
<h1>Event</h1>
<nav class="page-actions" aria-label="Event navigation">
    <a href="/events">Back to Events</a>
    @if (Error is not null)
    {
        <FluentButton Disabled="@Busy" OnClick="LoadAsync">Reload and recheck access</FluentButton>
    }
</nav>
<EventFeedback Busy="Busy" Error="@Error" />
@if (detail is not null)
{
    <EventCard Item="detail.Summary" />
    @if (detail.Summary.IsMember)
    {
        <EventManagementTabs Selected="selectedTab" IsOwner="detail.Summary.IsOwner" Disabled="Busy"
                             SelectedChanged="SelectTabAsync" />
        @switch (selectedTab)
        {
            case "quests":
                <EventQuestsPanel EventId="Id"
                                  CanCreate="@(detail.Summary.Status == EventStatus.Active)"
                                  CanModerate="detail.Summary.IsOwner" />
                break;
            case "members":
                <EventMembersPanel EventId="Id" Changed="LoadAsync" />
                break;
            case "invitations" when detail.Summary.IsOwner:
                <EventInvitationsPanel EventId="Id" />
                break;
            case "settings" when detail.Summary.IsOwner:
                <EventSettingsPanel Detail="detail" Changed="LoadAsync" />
                break;
            default:
                <section class="section-box">
                    <h2 class="section-heading">About this Event</h2>
                    <p class="description">@detail.Description</p>
                    <div class="page-actions">
                        <a href="@($"/notifications/preferences/{Id}")">Notification preferences</a>
                        @if (detail.Summary.IsOwner && detail.Summary.Status == EventStatus.Active)
                        {
                            <a href="@($"/events/{Id}/bulk")">One-time group add/invite</a>
                        }
                        @if (!detail.Summary.IsOwner)
                        {
                            <FluentButton Disabled="@Busy" OnClick="@(() => leaveDialogOpen = true)">Leave Event…</FluentButton>
                        }
                    </div>
                    @if (!detail.Summary.IsOwner)
                    {
                        <p class="text-muted">Owners must remove all Event and child Quest ownership assignments before leaving.</p>
                    }
                </section>
                break;
        }
    }
    else
    {
        <section class="section-box" aria-label="Join Event">
            <h2 class="section-heading">Join this Event</h2>
            <p>Join directly to see the full Event and its authorized Quests. No owner approval is required.</p>
            <FluentButton Appearance="Appearance.Accent" Disabled="@Busy" OnClick="JoinAsync">Join Event</FluentButton>
        </section>
    }
}

<ConfirmActionDialog Open="leaveDialogOpen"
                     Title="Leave Event"
                     ConfirmLabel="Leave Event"
                     Busy="Busy"
                     Confirmed="LeaveAsync"
                     Dismissed="@(() => leaveDialogOpen = false)">
    <p>Leaving removes your Quest invitations, attendance, follows, and applicable calendar entries for this Event.</p>
</ConfirmActionDialog>

@code {
    /// <summary>Internal Event route identifier; every load reauthorizes it on the server.</summary>
    [Parameter] public Guid Id { get; set; }
    private EventDetail? detail;
    private string selectedTab = "overview";
    private bool leaveDialogOpen;
    /// <inheritdoc />
    protected override Task OnParametersSetAsync() => LoadAsync();
    /// <inheritdoc />
    protected override Task RefreshAfterReconnectAsync() => LoadAsync();
    private Task LoadAsync() => RunAsync(async token =>
    {
        detail = null;
        leaveDialogOpen = false;
        var loaded = await Events.GetAsync(Id, token);
        token.ThrowIfCancellationRequested();
        detail = loaded;
        if (!loaded.Summary.IsOwner && selectedTab is "invitations" or "settings")
            selectedTab = "overview";
    });

    private Task JoinAsync() => RunMutationAsync(async token =>
    {
        await Events.JoinAsync(Id, token);
        var loaded = await Events.GetAsync(Id, token);
        token.ThrowIfCancellationRequested();
        detail = loaded;
    });

    private Task SelectTabAsync(string tab)
    {
        selectedTab = tab;
        return Task.CompletedTask;
    }

    private Task LeaveAsync() => RunMutationAsync(async token =>
    {
        await Events.LeaveAsync(Id, token);
        detail = null;
        leaveDialogOpen = false;
        Navigation.NavigateTo("/events");
    });
    /// <inheritdoc />
    protected override void ClearProtectedState() => detail = null;
}
