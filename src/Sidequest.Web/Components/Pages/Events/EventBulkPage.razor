@page "/events/{Id:guid}/bulk"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits EventViewBase
@inject NavigationManager Navigation

<PageTitle>One-time group expansion · Sidequest</PageTitle>
<h1>One-time group add or invitation</h1>
<a href="@($"/events/{Id}")">Event</a>
<EventFeedback Busy="Busy" Error="@Error" />
@if (authorized)
{
    <section class="section-box" aria-label="Group expansion">
        <h2 class="section-heading">Choose a group</h2>
        <p>This operation expands the full group before changing any memberships. Supported nested groups are included.
            Source groups never grant ongoing access. Group changes after expansion do not change Event membership.</p>
        <DirectoryPicker Groups="true" GroupSelected="SelectGroup" RecheckAccess="LoadAsync" />
        @if (selected is not null)
        {
            <p>Selected group: @selected.DisplayName</p>
            <div class="field-grid">
                <label>Action
                    <InputSelect @bind-Value="mode" disabled="@Busy">
                        <option value="@BulkMode.Add">Add individual memberships (never restore removed users)</option>
                        <option value="@BulkMode.Invite">Invite individuals to accept membership</option>
                    </InputSelect>
                </label>
            </div>
            <FluentCheckbox @bind-Value="confirmed" Disabled="@Busy">I confirm this one-time expansion. Application may finish with explicit skips or partial failures; later removals take precedence.</FluentCheckbox>
            <div class="page-actions">
                <FluentButton Disabled="@(Busy || !confirmed)" OnClick="StartAsync">Start background expansion</FluentButton>
            </div>
        }
    </section>
}

@code {
    /// <summary>Event whose owner initiates a full frozen directory expansion.</summary>
    [Parameter] public Guid Id { get; set; }
    private bool authorized;
    private bool confirmed;
    private DirectoryGroup? selected;
    private BulkMode mode;
    /// <inheritdoc />
    protected override Task OnParametersSetAsync() => LoadAsync();
    /// <inheritdoc />
    protected override Task RefreshAfterReconnectAsync() => LoadAsync();
    private Task LoadAsync() => RunAsync(async token =>
    {
        authorized = false;
        var item = await Events.GetAsync(Id, token);
        token.ThrowIfCancellationRequested();
        if (!item.Summary.IsOwner || item.Summary.Status != EventStatus.Active)
            throw new Sidequest.Domain.Rules.DomainException(Sidequest.Domain.Rules.ErrorCode.NotFound, "Unavailable.");
        authorized = true;
    });
    private void SelectGroup(DirectoryGroup group)
    {
        selected = group;
        confirmed = false;
    }
    private Task StartAsync() => RunMutationAsync(async token =>
    {
        if (selected is not null)
        {
            var operation = await Events.StartBulkAsync(Id, selected.ObjectId, mode, token);
            Navigation.NavigateTo($"/events/bulk/{operation}");
        }
    });
    /// <inheritdoc />
    protected override void ClearProtectedState()
    {
        authorized = false;
        selected = null;
    }
}
