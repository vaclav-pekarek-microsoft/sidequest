@page "/events"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits EventViewBase

<PageTitle>Events · Sidequest</PageTitle>
<PageHero Eyebrow="Your shared context"
          Title="Events"
          Summary="Find the company moments where Quests happen, then join, organize, or help others connect.">
    <Actions>
        <a class="button-link" href="/events/create">Create Event</a>
    </Actions>
</PageHero>
<nav class="page-actions" aria-label="Event actions">
    <a href="/events/invitations">My invitations</a>
</nav>
<fieldset class="event-filters" disabled="@Busy">
    <legend>Find your Events</legend>
    <div class="event-filter-actions">
        <button type="button" class="@(kind == EventListKind.All ? "selected" : null)"
                disabled="@Busy" @onclick="() => SelectAsync(EventListKind.All)">All Events</button>
        <button type="button" class="@(kind == EventListKind.Mine ? "selected" : null)"
                disabled="@Busy" @onclick="() => SelectAsync(EventListKind.Mine)">Joined Events</button>
        <button type="button" class="@(kind == EventListKind.History ? "selected" : null)"
                disabled="@Busy" @onclick="() => SelectAsync(EventListKind.History)">History</button>
        @if (Error is not null)
        {
            <FluentButton OnClick="LoadAsync" Disabled="@Busy">Reload</FluentButton>
        }
    </div>
</fieldset>
<h2>@(kind == EventListKind.All ? "All Events" : kind == EventListKind.Mine ? "Joined Events" : "Event history")</h2>
<EventFeedback Busy="Busy" Error="@Error" />
@if (result is not null)
{
    @if (result.Items.Count == 0)
    {
        <p>No Events in this view. Browse all Events and join one directly.</p>
    }
    <div class="event-card-grid">
        @foreach (var item in result.Items)
        {
            <EventCard @key="item.Id" Item="item" ShowParticipationActions="true"
                       Busy="Busy" JoinRequested="JoinAsync" LeaveRequested="OpenLeaveDialogAsync" />
        }
    </div>
    <EventPager Page="page" TotalCount="result.TotalCount" Busy="Busy" Changed="ChangePageAsync" />
}

<ConfirmActionDialog Open="@(leaveEventId is not null)"
                     Title="Leave Event"
                     ConfirmLabel="Leave Event"
                     Busy="Busy"
                     Error="@Error"
                     Confirmed="LeaveAsync"
                     Dismissed="DismissLeaveDialogAsync">
    <p>Leaving removes your Quest invitations, attendance, follows, and applicable calendar entries for this Event.</p>
</ConfirmActionDialog>

@code {
    private EventListKind kind = EventListKind.All;
    private int page = 1;
    private PageResult<EventSummary>? result;
    private Guid? leaveEventId;
    /// <inheritdoc />
    protected override Task OnInitializedAsync() => LoadAsync();
    /// <inheritdoc />
    protected override Task RefreshAfterReconnectAsync() => LoadAsync();

    private Task LoadAsync() => RunAsync(async token =>
    {
        result = null;
        var loaded = await Events.ListAsync(kind, new(page), token);
        token.ThrowIfCancellationRequested();
        result = loaded;
    });
    private Task SelectAsync(EventListKind selected)
    {
        kind = selected;
        page = 1;
        return LoadAsync();
    }
    private Task ChangePageAsync(int selected)
    {
        page = selected;
        return LoadAsync();
    }

    private Task JoinAsync(Guid eventId) => RunMutationAsync(async token =>
    {
        await Events.JoinAsync(eventId, token);
        await LoadPageAsync(token);
    });

    private Task OpenLeaveDialogAsync(Guid eventId)
    {
        leaveEventId = eventId;
        return Task.CompletedTask;
    }

    private Task DismissLeaveDialogAsync()
    {
        leaveEventId = null;
        return Task.CompletedTask;
    }

    private Task LeaveAsync() => RunMutationAsync(async token =>
    {
        if (leaveEventId is not { } eventId)
            return;
        await Events.LeaveAsync(eventId, token);
        leaveEventId = null;
        await LoadPageAsync(token);
    });

    private async Task LoadPageAsync(CancellationToken token)
    {
        result = null;
        var loaded = await Events.ListAsync(kind, new(page), token);
        token.ThrowIfCancellationRequested();
        result = loaded;
    }
    /// <inheritdoc />
    protected override void ClearProtectedState() => result = null;
}
