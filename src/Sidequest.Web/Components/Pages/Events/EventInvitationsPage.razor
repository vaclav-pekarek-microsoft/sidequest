@page "/events/invitations"
@page "/events/{Id:guid}/invitations"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits EventViewBase

<PageTitle>Event invitations · Sidequest</PageTitle>
<h1>@(Id is null ? "My Event invitations" : "Manage Event invitations")</h1>
<nav class="page-actions" aria-label="Invitation actions">
    <a href="@(Id is { } eventId ? $"/events/{eventId}" : "/events")">@(Id is null ? "Back to Events" : "Back to Event")</a>
</nav>
@if (Id is { } managedEventId)
{
    <EventInvitationsPanel EventId="managedEventId" />
}
else
{
    <p>Event invitations are optional outreach and require your acceptance. You can also join any Active Event directly.</p>
    <EventFeedback Busy="Busy" Error="@Error" />
    @if (result is not null)
    {
        @if (result.Items.Count == 0)
        {
            <p>No Event invitations.</p>
        }
        @foreach (var invitation in result.Items)
        {
            <article @key="invitation.Id" class="section-box">
                <h2>@invitation.EventName</h2>
                <p>@invitation.User.Label</p>
                <p>@invitation.Status · Expires @invitation.ExpiresUtc.ToString("g") UTC</p>
                @if (invitation.Status == EventInvitationStatus.Pending)
                {
                    <FluentButton Disabled="@Busy" OnClick="@(() => ActAsync(invitation.Id, true))">Accept Event membership</FluentButton>
                    <FluentButton Disabled="@Busy" OnClick="@(() => ActAsync(invitation.Id, false))">Decline</FluentButton>
                }
            </article>
        }
        <EventPager Page="page" TotalCount="result.TotalCount" Busy="Busy" Changed="PageAsync" />
    }
    @if (Error is not null)
    {
        <FluentButton Disabled="@Busy" OnClick="LoadAsync">Reload</FluentButton>
    }
}

@code {
    /// <summary>Managed Event identifier, or null for the current named recipient's invitations only.</summary>
    [Parameter] public Guid? Id { get; set; }
    private PageResult<EventInvitationSummary>? result;
    private int page = 1;
    /// <inheritdoc />
    protected override Task OnParametersSetAsync()
    {
        page = 1;
        return Id is null ? LoadAsync() : Task.CompletedTask;
    }
    private Task LoadAsync() => RunAsync(RefreshAsync);
    /// <inheritdoc />
    protected override Task RefreshAfterReconnectAsync() => LoadAsync();
    private async Task RefreshAsync(CancellationToken token)
    {
        result = null;
        var loaded = await Events.ListInvitationsAsync(null, new(page), token);
        token.ThrowIfCancellationRequested();
        result = loaded;
    }
    private Task ActAsync(Guid invitation, bool accept) => RunMutationAsync(async token =>
    {
        await Events.RespondToInvitationAsync(invitation, accept, token);
        await RefreshAsync(token);
    });
    private Task PageAsync(int selected)
    {
        page = selected;
        return LoadAsync();
    }
    /// <inheritdoc />
    protected override void ClearProtectedState() => result = null;
}
