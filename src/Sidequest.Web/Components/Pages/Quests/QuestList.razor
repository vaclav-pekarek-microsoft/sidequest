@rendermode InteractiveServer
@using Sidequest.Application.Quests
@using Sidequest.Web.Components.Quests
<PageTitle>Quests · Sidequest</PageTitle>
<h1>Quests</h1>
<nav class="page-actions" aria-label="Quest actions" data-online-actions>
    <a class="button-link" href="/quests/create">Create a Quest</a>
    <a href="/quests?view=Discover">Discover Quests</a>
    <a href="/quests?view=History">History</a>
    <a href="/quests?view=Invited">Private invitations</a>
</nav>
<nav class="quest-view-navigation" aria-label="Quest views">
    @foreach (var option in ViewOptions)
    {
        <button type="button" class="@(kind == option.Kind ? "selected" : null)"
                aria-pressed="@(kind == option.Kind ? "true" : "false")"
                disabled="@(loading || !RendererInfo.IsInteractive || !Experience.CanUseOnlineActions)"
                @onclick="() => SelectKindAsync(option.Kind)">@option.Label</button>
    }
</nav>
<fieldset class="compact-filters quest-filters" disabled="@(loading || !RendererInfo.IsInteractive || !Experience.CanUseOnlineActions)">
    <legend>Find your Quests</legend>
    <label>
        <span>Event</span>
        <select name="quest-list-event" @bind="eventFilter" @bind:after="ResetAsync" disabled="@(loading || !RendererInfo.IsInteractive || !Experience.CanUseOnlineActions)">
            <option value="">All my Events</option>
            @foreach (var item in events)
            {
                <option @key="item.Id" value="@item.Id">@item.Name</option>
            }
        </select>
    </label>
    <label>
        <span>From</span>
        <input name="quest-list-from" type="date" title="@DateSemantics" @bind="fromDate" @bind:after="ResetAsync" />
    </label>
    <label>
        <span>Through</span>
        <input name="quest-list-through" type="date" title="@DateSemantics" @bind="throughDate" @bind:after="ResetAsync" />
    </label>
    <small class="filter-help text-muted">Inclusive start dates in @dateZone. Select an Event to use its time zone.</small>
</fieldset>
<header class="results-header">
    <h2>@ViewHeading</h2>
    <div class="layout-switcher" role="group" aria-label="Quest layout">
        <button type="button" class="@(layout == QuestLayout.Board ? "selected" : null)"
                aria-pressed="@(layout == QuestLayout.Board ? "true" : "false")" @onclick="() => layout = QuestLayout.Board">Board</button>
        <button type="button" class="@(layout == QuestLayout.List ? "selected" : null)"
                aria-pressed="@(layout == QuestLayout.List ? "true" : "false")" @onclick="() => layout = QuestLayout.List">List</button>
    </div>
</header>
@if (loading)
{
    <p role="status">Loading authorized Quests…</p>
}
else if (error is not null)
{
    <p role="alert">@error</p>
    <FluentButton OnClick="LoadAsync" Disabled="@(!RendererInfo.IsInteractive || !Experience.CanUseOnlineActions)">Reload</FluentButton>
}
else if (result is null || result.Items.Count == 0)
{
    <p>No Quests in this view. Private invitations grant access immediately; there is nothing to accept.</p>
}
else
{
    <div class="@(layout == QuestLayout.Board ? "quest-board" : "quest-list")">
        @foreach (var item in result.Items)
        {
            <QuestCard @key="item.Id" Item="item" Moderation="@(kind == QuestListKind.Moderation)" />
        }
    </div>
}
<div class="quest-pagination">
    <FluentButton Disabled="@(loading || !RendererInfo.IsInteractive || !Experience.CanUseOnlineActions || page == 1)" OnClick="PreviousAsync">Previous</FluentButton>
    <span>Page @(page)</span>
    <FluentButton Disabled="@(loading || !RendererInfo.IsInteractive || !Experience.CanUseOnlineActions || result is null || page * 25 >= result.TotalCount)" OnClick="NextAsync">Next</FluentButton>
</div>
