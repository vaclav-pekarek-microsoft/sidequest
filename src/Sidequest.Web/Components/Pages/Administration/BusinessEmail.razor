@page "/administration/email"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase

<PageTitle>Business email · Sidequest</PageTitle>
<h1>Business email settings</h1>
<AdminPanel>
    <p>Message branding appears inside email subjects and bodies. It is not the ACS From display name. Verified sender, organizer, provider endpoints and credentials remain deployment-controlled.</p>
    <p>Required service messages cannot be disabled. Accepted user preference defaults remain unchanged. Changes affect newly prepared email; a previously attempted message keeps its captured wording and reply-to on retry.</p>
    <AdminFeedback Error="@Error" Busy="@Busy" Status="@Status" />
    <FluentButton OnClick="RefreshAsync" Disabled="@Disabled">Check current settings without discarding edits</FluentButton>
    @if (settings is not null && !Forbidden)
    {
        <fieldset class="section-box" disabled="@Disabled">
            <legend class="section-heading">Message branding</legend>
            <label for="email-brand">Message brand (1–80 characters)</label>
            <input id="email-brand" maxlength="80" @bind="brand" />
            <FluentButton OnClick="@(() => Review(() => pendingKey = BusinessEmailRules.BrandKey))" Disabled="@Disabled">Review brand change</FluentButton>
        </fieldset>
        <fieldset class="section-box" disabled="@Disabled">
            <legend class="section-heading">Reply-to contact</legend>
            <label for="email-reply">Reply-to mailbox (optional, no display name)</label>
            <input id="email-reply" maxlength="320" @bind="replyTo" />
            <FluentButton OnClick="@(() => Review(() => pendingKey = BusinessEmailRules.ReplyToKey))" Disabled="@Disabled">Review reply-to change</FluentButton>
        </fieldset>
        @if (currentSettings is not null)
        {
            <section class="section-box" aria-labelledby="current-settings">
                <h2 class="section-heading" id="current-settings">Latest saved values</h2>
                @foreach (var setting in currentSettings)
                {
                    <p @key="setting.Key">@setting.Key: @(setting.Value.Length == 0 ? "(none)" : setting.Value)</p>
                }
                <p>Your text is unchanged. Accepting these concurrency versions allows a subsequent confirmed save of your draft over the displayed values.</p>
                <FluentButton OnClick="AcceptVersions" Disabled="@Disabled">Use latest versions, keep my edits</FluentButton>
            </section>
        }
        @if (pendingKey is not null)
        {
            <section class="section-box" aria-labelledby="settings-confirm">
                <h2 class="section-heading" id="settings-confirm">Confirm email setting change</h2>
                <p>Save @pendingKey as @(pendingKey == BusinessEmailRules.BrandKey ? brand : replyTo)? This changes future prepared mail, not recipient, sender, organizer or mandatory delivery policy.</p>
                <FluentButton OnClick="SaveAsync" Disabled="@Disabled">Confirm setting change</FluentButton>
                <FluentButton OnClick="@(() => Review(() => pendingKey = null))" Disabled="@Disabled">Cancel change</FluentButton>
            </section>
        }
    }
    else if (!Busy)
    {
        <p>Email settings are unavailable. Current administrator access is required.</p>
    }
</AdminPanel>
