@page "/"
@inject FoundationAuthenticationSettings Authentication
@using Sidequest.Web.Components.Experience

<PageTitle>Sidequest · Quests and shared activities</PageTitle>
<AuthorizeView>
    <Authorized>
        <QuestDashboard />
    </Authorized>
    <NotAuthorized>
        <section class="landing">
            <PageHero Eyebrow="Find your people. Make a little time."
                      Title="Small activities. Shared energy."
                      Summary="Sidequest turns company Events into memorable moments with the colleagues around you."
                      Class="landing-hero">
                <Actions>
                    <SignInLink Class="button-link" />
                </Actions>
            </PageHero>
            <div class="feature-grid">
                <FeatureTile Index="01" Title="Discover" Tone="blue">
                    Join an Event and find public Quests that match your time, location, and interests.
                </FeatureTile>
                <FeatureTile Index="02" Title="Create" Tone="violet">
                    Organize a quick activity, invite Event members, and make space for something unexpected.
                </FeatureTile>
                <FeatureTile Index="03" Title="Connect" Tone="amber">
                    Attend when you can, follow when you cannot, and keep private Quests within trusted Event circles.
                </FeatureTile>
            </div>
            @if (Authentication.IsDevelopment)
            {
                <p class="environment-note">This local demo uses named synthetic personas and the configured development SQL database. It does not verify workforce eligibility or production readiness.</p>
            }
            else
            {
                <p class="environment-note">Sign in with your Microsoft alias to explore Quests in your Events.</p>
            }
        </section>
    </NotAuthorized>
</AuthorizeView>
