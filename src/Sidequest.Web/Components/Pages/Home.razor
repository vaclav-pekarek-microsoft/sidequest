@page "/"
@inject FoundationAuthenticationSettings Authentication
@using Sidequest.Web.Components.Experience

<PageTitle>Sidequest · Quests and shared activities</PageTitle>
<AuthorizeView>
    <Authorized>
        <QuestDashboard />
    </Authorized>
    <NotAuthorized>
<section class="landing">
<p class="eyebrow">Find your people. Make a little time.</p>
<h1>Small activities. Shared experiences.</h1>
<p>Organize activities with colleagues during company Events.</p>
<FluentCard Class="foundation-card">
    <h2>Find your next Quest</h2>
    <p>Join an Event to discover its public Quests, organize an activity, or follow an activity without attending.</p>
    <p>Private Quests are available only to their owners and invited Event members. Event membership and Quest attendance are separate.</p>
</FluentCard>
@if (Authentication.IsDevelopment)
{
    <p>This local demo uses named synthetic personas and the configured development SQL database. It does not verify Entra authentication, workforce eligibility or production readiness.</p>
}
else
{
    <p>Sign in with your assigned Microsoft account to explore Quests in your Events.</p>
}
        <div class="landing-sign-in"><SignInLink Class="button-link" /></div>
</section>
    </NotAuthorized>
</AuthorizeView>
