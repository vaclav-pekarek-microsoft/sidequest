@page "/"
@inject FoundationAuthenticationSettings Authentication
@using Sidequest.Web.Components.Experience

<PageTitle>Sidequest · Events and Quests</PageTitle>
<AuthorizeView>
    <Authorized>
        <QuestDashboard />
    </Authorized>
    <NotAuthorized>
<h1>Small activities. Shared experiences.</h1>
<p>Organize activities with colleagues during company Events.</p>
<FluentCard Class="foundation-card">
    <h2>Events and Quests</h2>
    <p>Join an Event to discover its public Quests, organize an activity, or follow an activity without attending.</p>
    <p>Private Quests are available only to their owners and invited Event members. Event membership and Quest attendance are separate.</p>
</FluentCard>
<h2>Sign-in information</h2>
@if (Authentication.IsDevelopment)
{
    <p>This local demo uses named synthetic personas and real local SQL storage. It does not verify Entra authentication, workforce eligibility or production readiness.</p>
}
else
{
    <p>Sign-in requires a workforce account explicitly assigned the approved eligibility app role in the configured Entra tenant. Tenant membership or an email address alone does not grant access.</p>
}
        <a href="/signin" data-enhance-nav="false">View sign-in options</a>
        <p><a href="/install">Install and device privacy</a></p>
    </NotAuthorized>
</AuthorizeView>
