@using Sidequest.Domain.Model
<EditForm Model="model" OnValidSubmit="SaveAsync" FormName="quest-editor">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <fieldset class="section-box" disabled="@Busy">
        <legend class="section-heading">Quest details</legend>
        <FluentTextField Label="Title" @bind-Value="model.Title" Disabled="@Busy" Required="true" />
        <FluentTextArea Label="Description (plain text)" @bind-Value="model.Description" Disabled="@Busy" />
        <FluentTextField Label="Location (required to publish)" @bind-Value="model.Location" Disabled="@Busy" />
        <label>Suggested capacity <InputNumber @bind-Value="model.Capacity" /></label>
    </fieldset>
    <fieldset class="section-box" disabled="@Busy">
        <legend class="section-heading">When</legend>
        <p>Event time zone: <strong>@ZoneId</strong> (inherited, read-only).</p>
        <div class="field-grid">
            <QuestLocalTimeInput Label="Starts in Event zone" OccurrenceLabel="Start occurrence" ZoneId="@ZoneId"
                                 @bind-Value="model.Start" @bind-Offset="model.StartOffset" Disabled="@Busy" />
            <QuestLocalTimeInput Label="Ends in Event zone" OccurrenceLabel="End occurrence" ZoneId="@ZoneId"
                                 @bind-Value="model.End" @bind-Offset="model.EndOffset" Disabled="@Busy" />
        </div>
    </fieldset>
    <fieldset class="section-box" disabled="@Busy">
        <legend class="section-heading">Who can see this Quest</legend>
        <label>Visibility
            <InputSelect @bind-Value="model.Visibility" disabled="@Published">
                <option value="@QuestVisibility.Public">Public within this Event</option>
                <option value="@QuestVisibility.Private">Private, named Event members only</option>
            </InputSelect>
        </label>
        <p class="text-muted">Private Quest content and owners can be inspected by Event owners in an audited moderation view.
            They cannot see invitation, attendee, or follower rosters in that view.</p>
    </fieldset>
    <div class="page-actions">
        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@Busy">Save @(Published ? "changes" : "draft")</FluentButton>
    </div>
</EditForm>
